# Copy to .env and adjust. docker compose reads this file automatically.

# Who plays the opposing trainer:
#   auto        -> claude if ANTHROPIC_API_KEY is set, else claude_code if the Claude Code
#                  CLI is installed and logged in, else heuristic
#   claude_code -> Claude Code CLI using your Claude subscription (`claude login`), no API key
#   claude      -> Anthropic API (needs ANTHROPIC_API_KEY and prepaid credits)
#   heuristic   -> built-in rule-based trainer, no LLM
OPPONENT_AGENT=auto

# Only needed for OPPONENT_AGENT=claude.
ANTHROPIC_API_KEY=

# The single model used for every LLM call in the app (trainer and coach, API and CLI):
#   claude-haiku-4-5  -> cheapest ($1 / $5 per million tokens); default
#   claude-sonnet-5   -> stronger play, about 2x the cost
#   claude-opus-5     -> best play, about 5x the cost
OPPONENT_MODEL=claude-haiku-4-5

# API-only, Opus/Sonnet 5 only (ignored on Haiku): thinking effort low | medium | high.
OPPONENT_EFFORT=low

# Seconds to wait for a decision before the heuristic trainer takes over.
OPPONENT_TIMEOUT_SECONDS=90

# Comma-separated origins allowed to call the API (dev server + nginx frontend).
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Where your Claude Code login lives on the host (mounted into the backend container).
# Only change these if `claude login` stored them somewhere other than your home directory.
# CLAUDE_DIR=~/.claude
# CLAUDE_JSON=~/.claude.json
